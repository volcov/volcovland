<div class="min-h-screen flex flex-col gap-4 p-4 sm:p-6 lg:p-8 bg-zinc-100 dark:bg-gray-950">
  <Layouts.site_header />

  <div class="flex-1 grid gap-4 grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 lg:grid-rows-4 lg:min-h-0">
    <!-- Hero -->
    <section class="sm:col-span-2 lg:col-start-1 lg:col-span-2 lg:row-start-1 lg:row-span-4 flex flex-col justify-center gap-5 rounded-2xl border border-zinc-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-7 sm:p-9">
      <span class="font-mono text-[10px] uppercase tracking-[0.16em] text-gray-400 dark:text-gray-500">
        Welcome
      </span>

      <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight leading-[1.12] text-gray-900 dark:text-white max-w-[24ch]">
        Hey, I'm Bruno. But you can call me <span class="text-purple-600 dark:text-purple-400">Volcov</span>, if you don't talk about Bruno.
      </h1>

      <p class="text-base sm:text-lg leading-relaxed text-gray-600 dark:text-gray-300 max-w-[48ch]">
        My little world on the internet, where I share about Elixir,
        theme parks, and other interests.
      </p>

      <div class="flex flex-col sm:flex-row gap-3 pt-1">
        <.link
          navigate={~p"/blog"}
          class="px-5 py-2.5 rounded-full bg-gray-900 dark:bg-white text-white dark:text-gray-900 font-semibold text-sm text-center hover:opacity-90 transition"
        >
          Read the blog
        </.link>
        <.link
          navigate={~p"/about"}
          class="px-5 py-2.5 rounded-full border border-zinc-200 dark:border-gray-700 text-gray-700 dark:text-gray-200 font-semibold text-sm text-center hover:bg-zinc-100 dark:hover:bg-gray-800 transition"
        >
          About me
        </.link>
      </div>
    </section>
    
<!-- Who -->
    <section class="lg:col-start-4 lg:row-start-1 lg:row-span-2 flex flex-col items-center justify-center gap-3 text-center rounded-2xl border border-transparent bg-gradient-to-br from-purple-600 to-purple-900 p-6 text-white">
      <img
        src="https://github.com/volcov.png"
        alt="Bruno Volcov"
        class="w-[74px] h-[74px] rounded-full border-[3px] border-white/35"
      />
      <div>
        <div class="font-semibold text-[15px]">Bruno Volcov</div>
        <div class="text-xs leading-snug text-white/75">
          Software Engineer &amp;&amp; Technical Lead<br />Canary Data
        </div>
      </div>
    </section>
    
<!-- Coasters -->
    <section class="lg:col-start-3 lg:row-start-1 lg:row-span-4 flex flex-col rounded-2xl border border-zinc-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-6 overflow-hidden">
      <span class="font-mono text-[10px] uppercase tracking-[0.16em] text-gray-400 dark:text-gray-500">
        Rides
      </span>
      <div class="mt-3">
        <div class="text-4xl font-bold tracking-tight leading-none text-gray-900 dark:text-white">
          {@rides}
        </div>
        <div class="text-xs text-gray-500 dark:text-gray-400 mt-1.5">
          across {@parks} parks visited 🎢
        </div>
      </div>

      <div class="mt-5 pt-4 border-t border-zinc-200 dark:border-gray-800 flex flex-col flex-1 min-h-0">
        <span class="font-mono text-[10px] uppercase tracking-[0.16em] text-gray-400 dark:text-gray-500 shrink-0">
          My top 10
        </span>

        <ol class="mt-3 space-y-1.5 flex-1 min-h-0 overflow-y-auto">
          <li
            :for={{ride, rank} <- Enum.with_index(@top_rides, 1)}
            class="flex items-baseline gap-2.5"
          >
            <span class={[
              "font-mono text-[10px] tabular-nums w-4 shrink-0",
              if(rank == 1,
                do: "text-purple-600 dark:text-purple-400",
                else: "text-gray-400 dark:text-gray-500"
              )
            ]}>
              {rank}
            </span>
            <span class="min-w-0">
              <span
                class="block text-[13px] font-medium leading-tight truncate text-gray-900 dark:text-white"
                title={ride.name}
              >
                {ride.name}
              </span>
              <span
                class="block text-[11px] leading-tight truncate text-gray-500 dark:text-gray-400"
                title={ride.park}
              >
                {ride.park}
              </span>
            </span>
          </li>
        </ol>
      </div>
    </section>
    
<!-- Socials -->
    <section class="lg:col-start-4 lg:row-start-3 flex flex-row items-center justify-center gap-3 rounded-2xl border border-zinc-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-6">
      <a
        href="https://github.com/volcov"
        target="_blank"
        rel="noopener noreferrer"
        class="w-10 h-10 flex items-center justify-center rounded-xl bg-gray-900 dark:bg-gray-800 text-white hover:opacity-85 transition"
        title="GitHub"
      >
        <span class="sr-only">GitHub</span>
        <svg class="w-[19px] h-[19px]" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
        </svg>
      </a>
      <a
        href="https://www.linkedin.com/in/bruno-volcov-b0292154/"
        target="_blank"
        rel="noopener noreferrer"
        class="w-10 h-10 flex items-center justify-center rounded-xl bg-[#0a66c2] text-white hover:opacity-85 transition"
        title="LinkedIn"
      >
        <span class="sr-only">LinkedIn</span>
        <svg class="w-[19px] h-[19px]" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
        </svg>
      </a>
      <a
        href="https://canarydata.ai/"
        target="_blank"
        rel="noopener noreferrer"
        class="w-10 h-10 flex items-center justify-center rounded-xl bg-amber-400 text-gray-900 hover:opacity-85 transition"
        title="Canary Data"
      >
        <span class="sr-only">Canary Data</span>
        <img src={~p"/images/canary-data.png"} alt="" class="w-[26px]" aria-hidden="true" />
      </a>
    </section>
    
<!-- Latest post -->
    <section class="lg:col-start-4 lg:row-start-4 rounded-2xl border border-zinc-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-6 overflow-hidden">
      <%= if @latest_post do %>
        <.link
          navigate={~p"/blog/#{@latest_post.id}"}
          class="group flex flex-col justify-between gap-3 h-full"
        >
          <div class="min-h-0">
            <span class="font-mono text-[10px] uppercase tracking-[0.16em] text-gray-400 dark:text-gray-500">
              Latest post
            </span>
            <h2 class="mt-2 text-[15px] font-semibold tracking-tight leading-snug line-clamp-2 text-gray-900 dark:text-white group-hover:text-purple-600 dark:group-hover:text-purple-400 transition">
              {@latest_post.title}
            </h2>
          </div>
          <div class="text-xs truncate text-gray-500 dark:text-gray-400">
            {Calendar.strftime(@latest_post.date, "%B %Y")}
            <%= if @latest_post.tags != [] do %>
              · {Enum.join(@latest_post.tags, ", ")}
            <% end %>
          </div>
        </.link>
      <% else %>
        <div class="flex flex-col justify-between gap-3 h-full">
          <div class="min-h-0">
            <span class="font-mono text-[10px] uppercase tracking-[0.16em] text-gray-400 dark:text-gray-500">
              Latest post
            </span>
            <h2 class="mt-2 text-[15px] font-semibold tracking-tight leading-snug line-clamp-2 text-gray-500 dark:text-gray-400">
              Nothing published yet.
            </h2>
          </div>
          <div class="text-xs text-gray-400 dark:text-gray-500">Coming soon</div>
        </div>
      <% end %>
    </section>
  </div>
</div>
