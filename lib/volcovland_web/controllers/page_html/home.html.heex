<div class="min-h-screen flex items-center justify-center">
  <!-- Hero Section -->
  <section class="max-w-4xl mx-auto px-4 py-20 text-center">
    <h1 class="text-5xl md:text-6xl font-bold mb-6 flex items-center justify-center gap-3">
      <svg
        class="h-12 md:h-16 w-12 md:w-16"
        viewBox="0 0 100 120"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <!-- bubble with more organic shape and inclined tip -->
        <path
          d="M55 8 C52 12, 45 22, 38 35 C32 45, 25 58, 23 70 C21 85, 28 98, 40 104 C48 108, 58 108, 66 104 C78 98, 85 85, 83 70 C81 58, 74 45, 68 35 C61 22, 58 12, 55 8 Z"
          fill="#7c3aed"
          stroke="#6d28d9"
          stroke-width="2"
        />
        
<!-- cartoon eyes -->
        <circle cx="42" cy="60" r="4" fill="#1f2937" />
        <circle cx="58" cy="60" r="4" fill="#1f2937" />
        <circle cx="43" cy="59" r="1.5" fill="white" />
        <circle cx="59" cy="59" r="1.5" fill="white" />
        
<!-- smile -->
        <path
          d="M 40 70 Q 50 75, 60 70"
          stroke="#1f2937"
          stroke-width="2"
          fill="none"
          stroke-linecap="round"
        />
      </svg>
      Welcome to <span class="text-purple-600">Volcovland</span>
      🎢
    </h1>

    <p class="text-xl text-gray-600 mb-8 max-w-2xl mx-auto">
      My little world on the internet where I share about programming,
      theme parks, and other interests.
    </p>

    <div class="flex gap-4 justify-center">
      <button
        disabled
        class="px-6 py-3 bg-gray-300 text-gray-500 rounded-lg cursor-not-allowed font-semibold"
        title="Coming soon"
      >
        Blog (Coming Soon)
      </button>
      <.link
        navigate={~p"/about"}
        class="px-6 py-3 border-2 border-purple-600 text-purple-600 rounded-lg hover:bg-purple-50 transition font-semibold"
      >
        About Me
      </.link>
    </div>
  </section>
</div>
