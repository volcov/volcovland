<div class="min-h-screen flex flex-col gap-6 p-4 sm:p-6 lg:p-8 bg-zinc-100 dark:bg-gray-950">
  <Layouts.site_header />

  <main class="w-full max-w-3xl mx-auto flex-1">
    <.link
      navigate={~p"/"}
      class="inline-flex items-center gap-1.5 text-sm font-medium text-purple-600 dark:text-purple-400 hover:text-purple-700 dark:hover:text-purple-300 transition"
    >
      <span aria-hidden="true">←</span> Back to home
    </.link>

    <div class="mt-6 mb-8">
      <span class="font-mono text-[10px] uppercase tracking-[0.16em] text-gray-400 dark:text-gray-500">
        Writing
      </span>
      <h1 class="mt-2 text-3xl sm:text-4xl font-bold tracking-tight text-gray-900 dark:text-white">
        Blog
      </h1>
      <p class="mt-3 text-base sm:text-lg leading-relaxed text-gray-600 dark:text-gray-300">
        Notes on Elixir, theme parks, and whatever else I've been chewing on.
      </p>
    </div>

    <%= if @posts == [] do %>
      <div class="rounded-2xl border border-dashed border-zinc-300 dark:border-gray-800 bg-white/60 dark:bg-gray-900/60 p-10 sm:p-14 text-center">
        <div class="text-4xl" aria-hidden="true">🎢</div>
        <p class="mt-4 font-semibold tracking-tight text-gray-900 dark:text-white">
          Nothing published yet
        </p>
        <p class="mt-1.5 text-sm text-gray-500 dark:text-gray-400">
          The first post is on its way.
        </p>
      </div>
    <% else %>
      <div class="space-y-4">
        <.link
          :for={post <- @posts}
          navigate={~p"/blog/#{post.id}"}
          class="group block rounded-2xl border border-zinc-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-6 hover:border-purple-300 dark:hover:border-purple-700 transition"
        >
          <div class="font-mono text-[10px] uppercase tracking-[0.16em] text-gray-400 dark:text-gray-500">
            {Calendar.strftime(post.date, "%B %-d, %Y")}
          </div>

          <h2 class="mt-2.5 text-xl font-semibold tracking-tight leading-snug text-gray-900 dark:text-white group-hover:text-purple-600 dark:group-hover:text-purple-400 transition">
            {post.title}
          </h2>

          <p class="mt-2 leading-relaxed text-gray-600 dark:text-gray-300">
            {post.description}
          </p>

          <div :if={post.tags != []} class="flex flex-wrap gap-1.5 mt-4">
            <span
              :for={tag <- post.tags}
              class="text-xs px-2.5 py-1 rounded-lg bg-zinc-100 dark:bg-gray-800 text-gray-600 dark:text-gray-300"
            >
              {tag}
            </span>
          </div>
        </.link>
      </div>
    <% end %>
  </main>
</div>
